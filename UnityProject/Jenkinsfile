pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'rm -rf Builds'
                sh 'chmod +x build_mac.sh'
                sh './build_mac.sh'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'Logs/build_mac.log', allowEmptyArchive: true
        }
        success {
            archiveArtifacts artifacts: 'Builds/Game.zip', fingerprint: true
        }
    }
}
