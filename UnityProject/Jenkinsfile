pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'rm -rf Builds'
                sh 'chmod +x UnityProject/build_mac.sh'
                sh './UnityProject/build_mac.sh'
                sh 'ditto -c -k --keepParent Builds/Test/ExpeditionCamp.app Builds/Game.zip'
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'UnityProject/Logs/build_mac.log', allowEmptyArchive: true
        }
        success {
            archiveArtifacts artifacts: 'Builds/Game.zip', fingerprint: true
            withCredentials([string(credentialsId: 'discoed-webhook', variable: 'DISCORD_WEBHOOK')]) {
                discordSend(
                    webhookURL: env.DISCORD_WEBHOOK,
                    title: "빌드 성공",
                    link: env.BUILD_URL
                )
            }
        }
        failure {
            withCredentials([string(credentialsId: 'discoed-webhook', variable: 'DISCORD_WEBHOOK')]) {
                discordSend(
                    webhookURL: env.DISCORD_WEBHOOK,
                    title: "빌드 실패",
                    link: env.BUILD_URL
                )
            }
        }
    }
}
